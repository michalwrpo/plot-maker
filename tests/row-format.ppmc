# a comment

PLOT 
(n, y, color = #aa11aa, linewidth = 3.5) (m, z, color = "red")

suptitle = "An Example Plot"
title = "Showcasing the row format"

xlabel = "time"
ylabel = "energy"

show
#save

[./testdata/in2.txt]

format
{skip 3}
{-n-}
{-y-}
end format

[./testdata/in3.txt]

format
{-m-}
{-z-}
end format